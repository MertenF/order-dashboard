#:kivy 2.1.0

<StatusBar>:
    size_hint: (1, 0.1)
    
    canvas.before:
        Color:
            rgba: 0.2, 0.2, 0.2, 1
        Rectangle:
            pos: self.pos
            size: self.size
    Label:
        text: str(root.clock)
        # As large as fits: "HH:MM:SS" is about 4 em wide
        font_size: min(self.height * 0.7, self.width / 4.4)
    TextInput:
        id: order_input
        text: ''
        multiline: False
        hint_text: 'Order'
        hint_text_color: 0.75, 0.75, 0.75, 1
        # Fill the bar height and centre the text vertically; longer numbers scroll sideways
        font_size: (self.height - 12) / 1.25
        padding: [6, max(0, (self.height - self.line_height) / 2)]
        background_color: 0.4, 0.4, 0.4, 1
        text_validate_unfocus: False
        focus: True
    Label:
        id: stat_label
        # Wait time of the entered order, as large as fits ("999 min" is about 3.5 em wide)
        text: ''
        markup: True
        halign: 'center'
        font_size: min(self.height * 0.7, self.width / 4)

<ProductLabel>:
    text_size: self.size
    halign: 'left'
    valign: 'center'
    
<AmountLabel>:
    text_size: self.size
    halign: 'right'
    valign: 'center'
    text: '0000'
    
<ShiftLabel>:
    canvas.before:
        Color:
            rgba: 0.15, 0.15, 0.15, 1
        Rectangle:
            pos: self.pos
            size: self.size

<RefreshBar>:
    max: 10
    
<RootWidget>:
    orientation: vertical

